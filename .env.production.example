# Production environment for docker-compose.nginx.yml or docker-compose.prod.yml
# Copy to .env on the VPS and edit secrets before first deploy.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sales_health_check

APP_PORT=3105
# Optional second HTTP instance (docker-compose.scale.yml). Uncomment 3106 in nginx upstream too.
# APP_PORT_B=3106
APP_DOMAIN=health.example.com
APP_BASE_URL=https://health.example.com

# Prebuilt image from GitHub Actions (GHCR)
APP_IMAGE=ghcr.io/javid1371/sales-health-check:latest

EXPERT_VIEW_TOKEN=generate-with-openssl-rand-hex-32
AUTH_SESSION_SECRET=generate-with-openssl-rand-hex-32
# Fallback for report CTA; admin can override at /admin/report-settings
CAPACITY_MODE=free

# OTP SMS (Kavenegar)
# KAVENEGAR_API_KEY=
# KAVENEGAR_OTP_TEMPLATE=

# Admin panel — set one of:
# ADMIN_PASSWORD=
# ADMIN_PASSWORD_HASH=

# Sales expert panel (consultation leads) — set one of:
# SALES_EXPERT_PASSWORD=
# SALES_EXPERT_PASSWORD_HASH=

# Email recovery (optional)
# RESEND_API_KEY=
# EMAIL_FROM=noreply@example.com

# PDF export — campaign default: OFF (unset/false). Requires Playwright in image
# (CI var PDF_GENERATION_ENABLED=true) and optional override docker-compose.pdf.yml
# after load test. Do not enable during paid-acquisition peak.
# PDF_GENERATION_ENABLED=true

# Sentry (optional — baked into image at build time via CI secrets)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# Telegram / Bale messenger bots (optional)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# BALE_BOT_TOKEN=
# BALE_WEBHOOK_SECRET=

# SMS sales funnel
# SMS_FUNNEL_ENABLED=true
# Sales funnel modeling module (/funnel pages and /api/funnels)
# SALES_FUNNEL_ENABLED=true
# KAVENEGAR_SENDER_LINE=
# SMS_QUIET_HOURS_START=9
# SMS_QUIET_HOURS_END=21
# SMS_FUNNEL_MAX_UNANSWERED=4
# SMS_FUNNEL_CRON_SECRET=
# SMS_FUNNEL_WORKER_CONCURRENCY=5

# Scale readiness — async finish (ADR 0017). See docs/ops/scaling.md
# Requires REDIS_URL (set in compose) and finish-worker service.
ASYNC_FINISH_ENABLED=true
FINISH_WORKER_CONCURRENCY=3
# Compose wires app/workers through PgBouncer; do not override unless debugging.
# Keep connection_limit=10 per process (2 apps ≈ 20 HTTP pools + workers under MAX_CLIENT_CONN=100).
# DATABASE_URL=postgresql://USER:PASS@pgbouncer:6432/DB?connection_limit=10&pgbouncer=true
# DIRECT_URL=postgresql://USER:PASS@postgres:5432/DB   # migrate/seed only
# Campaign: keep PDF off (unset/false). CAPACITY_MODE=free at peak.
# Two app instances: COMPOSE_FILES="docker-compose.nginx.yml docker-compose.scale.yml" (see docs/ops/scaling.md)

# Auto lead assignment to sales experts (round-robin + SMS notification)
# LEAD_AUTO_ASSIGN_ENABLED=true
# LEAD_SYSTEM_ASSIGN_DELAY_HOURS=24

# Cron routes (/api/cron/*) share SMS_FUNNEL_CRON_SECRET — install host cron via:
#   chmod +x scripts/install-vps-crons.sh scripts/vps-cron-call.sh
#   ./scripts/install-vps-crons.sh
